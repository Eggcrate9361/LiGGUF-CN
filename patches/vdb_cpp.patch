+// --- UTF-8 杈呭姪 ---
+static inline size_t utf8_len(unsigned char c)
+{
+    if (c < 0x80) return 1;
+    if ((c & 0xE0) == 0xC0) return 2;
+    if ((c & 0xF0) == 0xE0) return 3;
+    if ((c & 0xF8) == 0xF0) return 4;
+    return 1;
+}
+
+static uint32_t utf8_cpt(const string &s, size_t i, size_t n)
+{
+    // 瑙ｇ爜涓€涓?UTF-8 鐮佺偣
+    unsigned char c = (unsigned char)s[i];
+    uint32_t cpt = 0;
+    if (n == 1) return c;
+    if (n == 2) cpt = (c & 0x1F) << 6;
+    if (n == 3) cpt = (c & 0x0F) << 12;
+    if (n == 4) cpt = (c & 0x07) << 18;
+    for (size_t k = 1; k < n; k++) {
+        unsigned char cc = (unsigned char)s[i + k];
+        if (n == 2) cpt |= (cc & 0x3F);
+        if (n == 3) cpt |= (cc & 0x3F) << (6 * (2 - k));
+        if (n == 4) cpt |= (cc & 0x3F) << (6 * (3 - k));
+    }
+    return cpt;
+}
+
+static bool is_chinese_char(uint32_t cpt)
+{
+    return (cpt >= 0x4E00 && cpt <= 0x9FFF) ||
+           (cpt >= 0x3400 && cpt <= 0x4DBF) ||
+           (cpt >= 0x20000 && cpt <= 0x2A6DF) ||
+           (cpt >= 0x2A700 && cpt <= 0x2B73F) ||
+           (cpt >= 0x2B740 && cpt <= 0x2B81F) ||
+           (cpt >= 0x2B920 && cpt <= 0x2CEAF) ||
+           (cpt >= 0xF900 && cpt <= 0xFAFF) ||
+           (cpt >= 0x2F800 && cpt <= 0x2FA1F);
+}
+
+static bool is_ws_cpt(uint32_t cpt)
+{
+    return cpt == ' ' || cpt == '\t' || cpt == '\n' || cpt == '\r' ||
+           cpt == '\f' || cpt == '\v' || cpt == 0x00A0 || cpt == 0x3000;
+}
+
+static bool is_punct_cpt(uint32_t cpt)
+{
+    if ((cpt >= '!' && cpt <= '/') || (cpt >= ':' && cpt <= '@')) return true;
+    if ((cpt >= '[' && cpt <= '`') || (cpt >= '{' && cpt <= '~')) return true;
+    return false;
+}
